# e-FIR Law Enforcement Portal — example environment configuration
# Copy to .env and fill in real values. Never commit the populated .env file.

# Application environment: development | production
APP_ENV=development

# Development/demo switch. Only the exact value 1 enables:
#   - the citizen dev auto-login convenience
#   - the acceptance-test OTP shortcut
# With TEST_MODE=1 the registration mobile step accepts the fixed code 123456.
# That code is still stored as a normal hashed otp_sessions row, so the 10-minute
# expiry, the three-attempt limit and the resend cooldown all stay enforced.
# Leave unset (or any other value) in production; every credential check, the real
# random OTP and the citizen verification gate then stay fully enforced.
TEST_MODE=

# Which citizen account the dev auto-login resolves to when TEST_MODE=1.
# Ignored unless TEST_MODE=1.
DEV_AUTO_LOGIN_USER=

# HTTP port for the NiceGUI/FastAPI server (default 8081)
PORT=8081

# Absolute path to the SQLite ledger. Defaults to data/fir_platform.db
# relative to the project root.
FIR_DB_PATH=

# HMAC key used by crypto_service.sign_block for ledger block signatures.
# There is no built-in default: signing raises a clear error until this is set.
# Generate your own:
#   python -c "import secrets; print('VALIDATOR_PRIVATE_KEY=' + secrets.token_hex(32))"
# Blocks written so far are plain SHA-256 chains and do not embed this value, so
# setting it now does not invalidate the existing ledger.
VALIDATOR_PRIVATE_KEY=replace-with-your-own-256-bit-hex-key

# Secret that signs the login session cookie (NiceGUI app.storage.user).
# The application refuses to start without it, and changing it logs out every
# active session. Generate your own:
#   python -c "import secrets; print('STORAGE_SECRET=' + secrets.token_hex(32))"
STORAGE_SECRET=replace-with-your-own-256-bit-hex-key

# SMS provider used to deliver registration OTPs in production (TEST_MODE unset).
# Both values are required, otherwise send_otp reports that delivery is not
# configured instead of claiming an OTP was sent. The code itself is never logged
# and never returned to the browser.
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER=EKSP

# Staff sign-in accounts, provisioned at startup. Needed because a fresh Render
# deploy starts from an empty SQLite ledger, so accounts cannot be inserted by
# hand into one machine's database file.
#
# One username per portal; the same username may be reused across portals because
# each login authenticates against its own role:
#   SEED_VERIFICATION_OFFICER_USERNAMES  -> /staff-portal/verification (VERIFICATION_OFFICER)
#   SEED_POLICE_OFFICER_USERNAMES        -> /staff-portal/police       (OFFICER)
#   SEED_MAIN_AUTHORIZED_OFFICER_USERNAMES -> /staff-portal/admin      (ADMIN, the Main
#                                          Authorized Officer console, which also opens
#                                          /authorized-officer/*)
# Lists are comma-separated. Passwords are stored as PBKDF2-HMAC-SHA256 hashes with
# an individual random salt, never plaintext. An account whose email, phone, name or
# badge already resolves for that role is left untouched, so repeated boots and
# redeploys create no duplicates. Leave SEED_OFFICER_PASSWORD unset to disable
# provisioning entirely; there is no default password in the code.
SEED_VERIFICATION_OFFICER_USERNAMES=
SEED_POLICE_OFFICER_USERNAMES=
SEED_MAIN_AUTHORIZED_OFFICER_USERNAMES=
SEED_OFFICER_PASSWORD=

# Optional: additional police officer usernames, or a custom email domain for the
# derived account addresses (<username>-<portal>@<domain>).
SEED_OFFICER_USERNAMES=
SEED_OFFICER_EMAIL_DOMAIN=

# Citizen account credentials and notification delivery.
# When a Verification Officer approves a registration, the portal issues a unique
# username, stores only a PBKDF2-HMAC-SHA256 password hash, and sends the citizen a
# single-use activation link over whichever provider is configured below. With no
# provider configured the delivery is recorded as NOT_CONFIGURED - the status page
# then offers the same link in-app, and nothing is ever reported as sent that was
# not accepted by a provider.
#
# Email provider (recommended). SMTP_HOST alone switches email on.
#   SMTP_USE_TLS: ssl (implicit TLS, typical on 465) | starttls (default, 587) | none
#   SMTP_MAIL_FROM falls back to SMTP_USERNAME when unset.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_MAIL_FROM=
SMTP_USE_TLS=starttls

# SMS provider. Needs both the endpoint and the key; the portal posts
# Authorization: Bearer <key> and records the provider's answer.
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER=EKSP

# Origin used to build activation and reset links. Set this to the public URL, or
# the links emailed to citizens only resolve on the machine running the app.
PUBLIC_BASE_URL=http://localhost:8081

# Activation / password-reset link lifetime and how many times one link may be
# tried before it is spent. A link is single-use either way: it is superseded by
# the next request and consumed on the first success.
ACTIVATION_LINK_TTL_HOURS=72
ACTIVATION_MAX_ATTEMPTS=5
