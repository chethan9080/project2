# Server Configuration
PORT=8081
HOST=0.0.0.0
ENVIRONMENT=development

# Security & Secrets — no code defaults exist for either value
# STORAGE_SECRET signs the login session cookie; the app refuses to start without it.
STORAGE_SECRET=replace-with-your-own-256-bit-hex-key
VALIDATOR_PRIVATE_KEY=replace-with-your-own-256-bit-hex-key

# Database
DATABASE_PATH=data/fir_platform.db

# Blockchain Node ID
VALIDATOR_NODE_ID=NODE-IN-KA-POLICE-01

# Development/testing shortcuts — leave unset in production.
# TEST_MODE=1 makes registration step 3 accept the fixed OTP 123456.
TEST_MODE=
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER=EKSP

# Staff accounts provisioned on every boot when the database is empty:
# verification desk, police workspace and Main Authorized Officer console.
# Each login authenticates against its own role, so one username can serve all
# three. Passwords are PBKDF2-hashed; unset the password to disable provisioning.
SEED_VERIFICATION_OFFICER_USERNAMES=
SEED_POLICE_OFFICER_USERNAMES=
SEED_MAIN_AUTHORIZED_OFFICER_USERNAMES=
SEED_OFFICER_PASSWORD=
SEED_OFFICER_USERNAMES=
